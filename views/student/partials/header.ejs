<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1b2a5b">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | <%= site.name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark admin-nav">
  <div class="container">
    <a class="navbar-brand" href="/student"><%= site.name %></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#studentMenu" aria-controls="studentMenu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="studentMenu">
      <ul class="navbar-nav me-auto">
        <% [['/student', 'Dashboard'], ['/student/exams', 'Exams'], ['/student/results', 'My results']].forEach(l => { %>
          <li class="nav-item"><a class="nav-link <%= (l[0] === '/student' ? currentPath === '/student' || currentPath === '/student/' : currentPath.startsWith(l[0])) ? 'active' : '' %>" href="<%= l[0] %>"><%= l[1] %></a></li>
        <% }) %>
      </ul>
      <div class="d-flex align-items-center gap-3">
        <span class="text-white-50"><%= student.name %></span>
        <form method="POST" action="/student/logout" class="m-0">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm btn-outline-light" type="submit">Log out</button>
        </form>
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>" role="status"><%= flash.text %></div>
<% } %>
