<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1 fw-bold text-dark"><i class="bi bi-trophy-fill text-warning me-2"></i>My Exam History & Results</h1>
    <p class="text-muted small mb-0">Record of all tests you have completed and their detailed breakdown.</p>
  </div>
</div>

<div class="admin-card shadow-sm">
  <% if (results.length === 0) { %>
    <div class="p-5 text-center text-muted">
      <i class="bi bi-trophy display-4 d-block mb-3 text-muted"></i>
      <h3 class="h5">No completed exams yet</h3>
      <p class="mb-3">Take an assessment to see your scores, percentage, and review questions.</p>
      <a href="/student/exams" class="btn btn-primary rounded-pill px-4">Browse Exams</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle table-hover mb-0 table-stack">
        <thead class="table-light">
          <tr>
            <th>Exam Title</th>
            <th>Date Completed</th>
            <th>Score</th>
            <th>Percentage</th>
            <th>Result</th>
            <th>Time Spent</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% results.forEach(r => { const pct = fmt.percent(r.score, r.total_marks); const passed = pct >= r.pass_percent; %>
            <tr>
              <td>
                <strong class="text-dark d-block"><%= r.title %></strong>
                <small class="text-muted"><%= fmt.statusLabel(r.status) %></small>
              </td>
              <td>
                <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i><%= fmt.dateTime(r.submitted_at) %></span>
              </td>
              <td><span class="fw-bold"><%= r.score %></span> / <%= r.total_marks %></td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="progress flex-grow-1" style="height: 8px; width: 70px;">
                    <div class="progress-bar <%= passed ? 'bg-success' : 'bg-danger' %>" role="progressbar" style="width: <%= Math.min(100, pct) %>%;"></div>
                  </div>
                  <span class="small fw-bold"><%= pct %>%</span>
                </div>
              </td>
              <td>
                <span class="badge rounded-pill <%= passed ? 'text-bg-success' : 'text-bg-danger' %> px-3 py-1">
                  <i class="bi <%= passed ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> me-1"></i><%= passed ? 'Pass' : 'Fail' %>
                </span>
              </td>
              <td>
                <span class="small text-muted"><i class="bi bi-clock-history me-1"></i><%= fmt.duration(new Date(r.submitted_at) - new Date(r.started_at)) %></span>
              </td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-primary rounded-pill px-3" href="/student/results/<%= r.exam_id %>">
                  <i class="bi bi-card-checklist me-1"></i>View Review
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>