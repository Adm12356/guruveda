<%- include('partials/header') %>
<h1 class="h3 mb-1">Welcome, <%= student.name %></h1>
<p class="text-muted mb-4">Batch: <%= student.batch_name || 'Not assigned yet' %></p>

<div class="row g-3 mb-4">
  <div class="col-md-4"><a class="text-decoration-none" href="/student/exams"><div class="admin-card"><div class="stat"><%= pending %></div><div class="text-muted">Exams to take</div></div></a></div>
  <div class="col-md-4"><a class="text-decoration-none" href="/student/results"><div class="admin-card"><div class="stat"><%= done %></div><div class="text-muted">Exams completed</div></div></a></div>
  <div class="col-md-4"><div class="admin-card"><div class="stat"><%= avg === null ? '-' : avg + '%' %></div><div class="text-muted">Average of recent results</div></div></div>
</div>

<% if (!student.batch_name) { %>
  <div class="alert alert-info">You have not been assigned to a batch yet, so no exams are available. Please contact your teacher.</div>
<% } %>

<div class="admin-card">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Recent results</h2>
    <a href="/student/results">All results</a>
  </div>
  <% if (recent.length === 0) { %>
    <p class="text-muted mb-0">No results yet. <a href="/student/exams">Go to exams</a></p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table mb-0 table-stack">
        <thead><tr><th>Exam</th><th>Score</th><th>Percentage</th><th>Result</th></tr></thead>
        <tbody>
          <% recent.forEach(r => { const pct = fmt.percent(r.score, r.total_marks); %>
            <tr>
              <td><a href="/student/results/<%= r.exam_id %>"><%= r.title %></a></td>
              <td><%= r.score %> / <%= r.total_marks %></td>
              <td><%= pct %>%</td>
              <td><span class="badge text-bg-<%= pct >= r.pass_percent ? 'success' : 'danger' %>"><%= pct >= r.pass_percent ? 'Pass' : 'Fail' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
