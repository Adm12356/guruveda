<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101c44">
  <meta name="robots" content="noindex, nofollow">
  <title>Student Login | <%= site.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body class="login-page-body student-login-bg">
  <div class="login-wrapper">
    <div class="login-card shadow-lg">
      <div class="login-card-header text-center student-header-bg">
        <div class="login-icon-circle bg-warning text-dark">
          <i class="bi bi-mortarboard-fill"></i>
        </div>
        <h1 class="h4 mt-3 mb-1 fw-bold text-dark">Student Portal</h1>
        <p class="text-muted small mb-0"><%= site.name %></p>
      </div>

      <div class="login-card-body p-4 p-sm-5">
        <% if (error) { %>
          <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <form method="POST" action="/student/login">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          
          <div class="mb-3">
            <label for="username" class="form-label fw-semibold">Student Username</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
              <input type="text" class="form-control" id="username" name="username" placeholder="e.g. rahul123" autocomplete="username" autocapitalize="none" required autofocus>
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label fw-semibold">Password</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
              <input type="password" class="form-control" id="password" name="password" placeholder="Enter password" autocomplete="current-password" required>
            </div>
          </div>

          <button class="btn btn-warning btn-lg w-100 rounded-pill fw-bold text-dark shadow-sm" type="submit">
            <i class="bi bi-rocket-takeoff-fill me-2"></i>Sign In & Start Learning
          </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center">
          <p class="small text-muted mb-0">Forgot your password? Please ask your teacher or parent to reset it.</p>
        </div>
      </div>
    </div>
    <div class="text-center mt-3 d-flex justify-content-center gap-3">
      <a href="/" class="text-decoration-none text-muted small">
        <i class="bi bi-house-door me-1"></i>Main Website
      </a>
      <span class="text-muted small">•</span>
      <a href="/admin/login" class="text-decoration-none text-muted small">
        <i class="bi bi-shield-lock me-1"></i>Teacher / Admin Login
      </a>
    </div>
  </div>
</body>
</html>