<%- include('partials/header') %>

<!-- Slider -->
<div id="homeSlider" class="carousel slide hero-slider" data-bs-ride="carousel" data-bs-interval="5500" aria-label="Highlights">
  <div class="carousel-indicators">
    <% slides.forEach((s, i) => { %>
      <button type="button" data-bs-target="#homeSlider" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" <%= i === 0 ? 'aria-current=true' : '' %> aria-label="Slide <%= i + 1 %>"></button>
    <% }) %>
  </div>
  <div class="carousel-inner">
    <% slides.forEach((s, i) => { %>
      <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
        <div class="slide tone-<%= s.tone %>" style="--img: url('/images/slider/<%= s.image %>');">
          <div class="container position-relative z-2">
            <div class="slide-copy">
              <div class="hero-chip mb-3">
                <span class="badge-dot"></span>
                <span>Mental Maths & Abacus Excellence</span>
              </div>
              <h1 class="slide-title"><%= s.title %></h1>
              <p class="lead slide-lead"><%= s.text %></p>
              <div class="d-flex flex-wrap gap-3 align-items-center pt-2">
                <a class="btn btn-bead btn-lg" href="<%= s.cta.href %>">
                  <span><%= s.cta.label %></span>
                  <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a class="btn btn-glass btn-lg" href="/about">
                  <i class="bi bi-play-circle me-1"></i>Explore Method
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#homeSlider" data-bs-slide="prev" aria-label="Previous">
    <span class="carousel-nav-btn"><i class="bi bi-chevron-left"></i></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#homeSlider" data-bs-slide="next" aria-label="Next">
    <span class="carousel-nav-btn"><i class="bi bi-chevron-right"></i></span>
  </button>
</div>

<!-- Creative Stats Banner -->
<section class="stats-banner">
  <div class="container">
    <div class="row g-3 g-md-4 text-center justify-content-center">
      <div class="col-6 col-md-3">
        <div class="stat-pill">
          <div class="stat-icon b-yellow-icon"><i class="bi bi-stars"></i></div>
          <div class="stat-pill-num">5000+</div>
          <div class="stat-pill-lbl">Children Trained</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-pill">
          <div class="stat-icon b-teal-icon"><i class="bi bi-geo-alt-fill"></i></div>
          <div class="stat-pill-num">10+</div>
          <div class="stat-pill-lbl">Centres & Franchises</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-pill">
          <div class="stat-icon b-coral-icon"><i class="bi bi-award-fill"></i></div>
          <div class="stat-pill-num">8 Levels</div>
          <div class="stat-pill-lbl">Structured Curriculum</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-pill">
          <div class="stat-icon b-sky-icon"><i class="bi bi-lightning-charge-fill"></i></div>
          <div class="stat-pill-num">5x Faster</div>
          <div class="stat-pill-lbl">Mental Calculation</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ABACUS meaning + what your child gains (two columns) -->
<section class="section about-split">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-stretch">

      <!-- Left: ABACUS -->
      <div class="col-lg-6 d-flex flex-column">
        <div class="split-col h-100">
          <div class="section-badge mb-2"><i class="bi bi-magic me-1"></i>Foundations</div>
          <h2 class="section-title">What does ABACUS stand for?</h2>
          <p class="section-intro">The abacus is more than an ancient tool — it is a complete brain gym structured for early childhood development.</p>

          <% const acronym = [
            { l: 'A', w: 'Abundant',    c: 'yellow', on: 'var(--ink)', t: 'Plenty of practice and engaging math games in every class.' },
            { l: 'B', w: 'Beads',       c: 'teal',   on: '#fff',       t: 'Colourful beads children can touch, move, and visualise.' },
            { l: 'A', w: 'Addition &',  c: 'coral',  on: '#fff',       t: 'A rock-solid foundation in fundamental arithmetic.' },
            { l: 'C', w: 'Calculation', c: 'sky',    on: '#fff',       t: 'Rapid multiplication, division, and lightning mental recall.' },
            { l: 'U', w: 'Utility',     c: 'yellow', on: 'var(--ink)', t: 'A lifelong cognitive skill for school exams and daily life.' },
            { l: 'S', w: 'System',      c: 'teal',   on: '#fff',       t: 'Step-by-step levels, transparent testing, and verified certificates.' }
          ]; %>

          <div class="acr-frame mt-3">
            <ol class="acr-list list-unstyled mb-0">
              <% acronym.forEach(function (r) { %>
                <li class="acr-row" style="--c: var(--<%= r.c %>); --on: <%= r.on %>;">
                  <span class="acr-letter" aria-hidden="true"><%= r.l %></span>
                  <div class="acr-body">
                    <h3 class="acr-word"><%= r.w %></h3>
                    <p class="acr-desc"><%= r.t %></p>
                  </div>
                </li>
              <% }) %>
            </ol>
          </div>
        </div>
      </div>

      <!-- Right: what your child gains -->
      <div class="col-lg-6 d-flex flex-column">
        <div class="split-col h-100">
          <div class="section-badge mb-2"><i class="bi bi-trophy me-1"></i>Benefits</div>
          <h2 class="section-title">What your child gains</h2>
          <p class="section-intro">By engaging both the visual right brain and analytical left brain, children develop lifelong superpowers.</p>

          <% const skills = [
            ['Concentration',      'Timed drills teach children to filter distractions and sustain sharp focus.', 'yellow', 'bi-bullseye'],
            ['Visual Memory',      'Picturing moving beads strengthens photographic recall and spatial awareness.', 'teal', 'bi-eye-fill'],
            ['Speed & Accuracy',  'Quick, accurate answers without relying on calculators or fingers.', 'coral', 'bi-stopwatch-fill'],
            ['Visualisation',      'Children "see" an imaginary abacus and slide virtual beads in mind.', 'sky', 'bi-lightbulb-fill'],
            ['Sharp Listening',    'Oral speed arithmetic drills cultivate keen, active listening.', 'yellow', 'bi-ear-fill'],
            ['Math Confidence',    'Overcoming math anxiety and building proud self-belief in academics.', 'teal', 'bi-balloon-heart-fill']
          ]; %>

          <div class="gain-grid mt-3">
            <% skills.forEach(function (s) { %>
              <div class="gain-card" style="--c: var(--<%= s[2] %>);">
                <div class="gain-icon"><i class="bi <%= s[3] %>"></i></div>
                <div class="gain-content">
                  <h3 class="gain-title"><%= s[0] %></h3>
                  <p class="gain-text"><%= s[1] %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Why parents choose us -->
<section class="section section-tint py-5">
  <div class="container">
    <div class="row g-4 g-lg-5 align-items-center">

      <div class="col-lg-5">
        <div class="section-badge mb-2"><i class="bi bi-shield-check me-1"></i>Why Us</div>
        <h2 class="section-title">Why parents choose <%= site.name %></h2>
        <p class="lead text-muted mb-4">We combine warm personal attention with structured, research-backed mental mathematics.</p>
        
        <div class="p-4 rounded-4 bg-white shadow-sm border border-light-subtle mb-4">
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="fs-1">🎯</span>
            <div>
              <h4 class="h6 mb-0">Free Assessment & Demo</h4>
              <p class="small text-muted mb-0">Experience how your child responds to the abacus with no obligations.</p>
            </div>
          </div>
        </div>

        <a class="btn btn-bead btn-lg shadow-sm" href="/contact">
          <i class="bi bi-mortarboard-fill me-2"></i>Enroll Your Child Here
        </a>
      </div>

      <div class="col-lg-7">
        <% const reasons = [
          { t: 'Ability to multitask with higher mental bandwidth', i: 'bi-check2-circle', c: 'yellow' },
          { t: 'Noticeable boost in school exam scores & confidence', i: 'bi-graph-up-arrow', c: 'teal' },
          { t: 'Enhanced photographic memory & attention span', i: 'bi-camera-fill', c: 'coral' },
          { t: 'Elimination of math fear & hesitation', i: 'bi-emoji-smile-fill', c: 'sky' },
          { t: 'Better logical problem-solving in everyday life', i: 'bi-puzzle-fill', c: 'yellow' },
          { t: 'Small batch sizes (6-10 students) for individual care', i: 'bi-people-fill', c: 'teal' },
          { t: 'Certified trainers with multi-year teaching credentials', i: 'bi-patch-check-fill', c: 'coral' }
        ]; %>
        <div class="reasons-wrap">
          <% reasons.forEach(function (r) { %>
            <div class="reason-pill" style="--c: var(--<%= r.c %>);">
              <span class="reason-icon"><i class="bi <%= r.i %>"></i></span>
              <span class="reason-text"><%= r.t %></span>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Upcoming events -->
<section class="section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
      <div>
        <div class="section-badge mb-1"><i class="bi bi-calendar-check me-1"></i>What's Happening</div>
        <h2 class="section-title mb-0">Upcoming Events & Camps</h2>
      </div>
      <a href="/events" class="btn btn-outline-ink btn-sm">
        View All Events <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
    <% if (events.length === 0) { %>
      <div class="p-5 text-center bg-light rounded-4">
        <i class="bi bi-calendar2-week display-4 text-muted mb-3 d-block"></i>
        <h3 class="h5">No events currently scheduled</h3>
        <p class="text-muted mb-0">Check back soon for new championships, workshops, and holiday camps.</p>
      </div>
    <% } else { %>
      <ul class="event-list list-unstyled mb-0">
        <% events.forEach(e => { %>
          <%- include('partials/event-row', { e }) %>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>

<!-- Call to action -->
<section class="cta-band">
  <div class="container position-relative z-2 text-center">
    <span class="cta-mini-tag">Join the <%= site.name %> Family</span>
    <h2 class="cta-heading">Book a Free Hands-On Demo Class</h2>
    <p class="lead cta-sub">Watch your child's eyes light up when they calculate multi-digit sums on the abacus for the very first time.</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a class="btn btn-bead btn-lg shadow-lg" href="/contact">
        <i class="bi bi-calendar-event me-2"></i>Book a Free Demo
      </a>
      <a class="btn btn-outline-light btn-lg" href="tel:<%= site.phone.replace(/\s/g, '') %>">
        <i class="bi bi-telephone-fill me-2"></i>Call <%= site.phone %>
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>