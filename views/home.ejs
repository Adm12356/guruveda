<!-- Upcoming events -->
<section class="section section-tint">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
      <h2 class="section-title mb-0">Coming up</h2>
      <a href="/events" class="link-strong">All events</a>
    </div>
    <% if (events.length === 0) { %>
      <p class="mb-0">No events are scheduled right now. Check back soon.</p>
    <% } else { %>
      <ul class="event-list list-unstyled mb-0">
        <% events.forEach(e => { %>
          <%- include('partials/event-row', { e }) %>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>

<!-- Call to action -->
<section class="cta-band">
  <div class="container text-center">
    <h2>Book a free demo class</h2>
    <p class="lead">Let your child try the abacus before you decide.</p>
    <a class="btn btn-bead btn-lg" href="/contact">Book a demo</a>
  </div>
</section>

<%- include('partials/footer') %>
