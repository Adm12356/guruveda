<li class="event-card-item mb-3">
  <div class="event-card-inner">
    <div class="event-date-badge" aria-hidden="true">
      <span class="d-month"><%= new Date(e.event_date).toLocaleDateString('en-IN', { month: 'short' }).toUpperCase() %></span>
      <span class="d-day"><%= new Date(e.event_date).getDate() %></span>
      <span class="d-year"><%= new Date(e.event_date).getFullYear() %></span>
    </div>
    <div class="event-details">
      <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
        <h3 class="event-title h5 mb-0"><%= e.title %></h3>
        <% const isSoon = (new Date(e.event_date) - new Date()) < (7 * 24 * 60 * 60 * 1000); %>
        <% if (isSoon) { %>
          <span class="badge text-bg-warning"><i class="bi bi-clock-history me-1"></i>Happening Soon</span>
        <% } %>
      </div>
      <% if (e.description) { %>
        <p class="event-desc mb-2 text-muted"><%= e.description %></p>
      <% } %>
      <div class="event-meta d-flex flex-wrap gap-3">
        <span class="meta-item"><i class="bi bi-clock me-1 text-primary"></i><%= new Date(e.event_date).toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' }) %></span>
        <% if (e.location) { %>
          <span class="meta-item"><i class="bi bi-geo-alt-fill me-1 text-danger"></i><%= e.location %></span>
        <% } %>
      </div>
    </div>
    <div class="event-action">
      <a href="/contact" class="btn btn-sm btn-bead">Inquire Now</a>
    </div>
  </div>
</li>