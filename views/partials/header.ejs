<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101c44">
  <title><%= title %> | <%= site.name %></title>
  <meta name="description" content="<%= site.name %> - <%= site.tagline %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>

<nav class="navbar navbar-expand-lg site-nav sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="brand-logo-wrap">
        <img src="/images/logo.jpeg" alt="" class="brand-logo" width="46" height="46" onerror="this.style.display='none'">
        <span class="brand-abacus-icon" aria-hidden="true">🧮</span>
      </div>
      <div class="brand-text">
        <span class="brand-title"><%= site.name %></span>
        <span class="brand-subtitle d-none d-sm-block"><%= site.tagline %></span>
      </div>
    </a>
    <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <% const links = [['/', 'Home', 'bi-house-door'], ['/about', 'About', 'bi-info-circle'], ['/events', 'Events', 'bi-calendar-event']]; %>
        <% links.forEach(l => { %>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === l[0] ? 'active' : '' %>" href="<%= l[0] %>" <%= currentPath === l[0] ? 'aria-current=page' : '' %>>
              <i class="bi <%= l[2] %> me-1 nav-icon"></i><%= l[1] %>
            </a>
          </li>
        <% }) %>
        <li class="nav-item">
          <a class="nav-link student-portal-link" href="/student/login">
            <span class="student-badge"><i class="bi bi-person-fill-lock me-1"></i>Student Portal</span>
          </a>
        </li>
        <li class="nav-item ms-lg-2">
          <a class="btn btn-bead" href="/contact">
            <i class="bi bi-chat-square-dots-fill me-1"></i>Book a Demo
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<% if (flash) { %>
  <div class="container mt-3">
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show modern-alert" role="status">
      <i class="bi <%= flash.type === 'success' ? 'bi-check-circle-fill' : (flash.type === 'danger' ? 'bi-exclamation-octagon-fill' : 'bi-info-circle-fill') %> me-2"></i>
      <%= flash.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>

<main id="main">