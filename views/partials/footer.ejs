</main>

<footer class="site-footer">
  <div class="container">
    <%- include('beads') %>
    <div class="row gy-4 pt-4">
      <div class="col-md-5">
        <h2 class="h5 footer-title"><%= site.name %></h2>
        <p class="mb-0"><%= site.tagline %></p>
      </div>
      <div class="col-6 col-md-3">
        <h2 class="h6 footer-title">Pages</h2>
        <ul class="list-unstyled mb-0">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/batches">Batches</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-4">
        <h2 class="h6 footer-title">Visit or call</h2>
        <address class="mb-0">
          <%= site.address %><br>
          <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a><br>
          <a href="mailto:<%= site.email %>"><%= site.email %></a><br>
          <%= site.hours %>
        </address>
      </div>
    </div>
    <p class="small copyright mb-0">&copy; <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
