<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0">Attendance report</h1>
  <a class="btn btn-outline-primary" href="/admin/attendance?batch=<%= batchId || '' %>">Mark attendance</a>
</div>
<div class="admin-card">
  <form method="GET" action="/admin/attendance/report" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
      <label class="form-label" for="batch">Batch</label>
      <select class="form-select" id="batch" name="batch" onchange="this.form.submit()">
        <% batches.forEach(b => { %><option value="<%= b.id %>" <%= b.id === batchId ? 'selected' : '' %>><%= b.name %></option><% }) %>
      </select>
    </div>
    <input type="hidden" name="month" value="<%= month %>">
  </form>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-sm btn-outline-primary" href="/admin/attendance/report?batch=<%= batchId || '' %>&month=<%= prev %>">&larr; Prev</a>
    <h2 class="h5 mb-0"><%= label %></h2>
    <% if (next) { %><a class="btn btn-sm btn-outline-primary" href="/admin/attendance/report?batch=<%= batchId || '' %>&month=<%= next %>">Next &rarr;</a>
    <% } else { %><span class="btn btn-sm btn-outline-secondary disabled">Next &rarr;</span><% } %>
  </div>
  <p class="text-muted small"><%= holidayCount %> holiday<%= holidayCount === 1 ? '' : 's' %> this month (not counted as absent).</p>
  <% if (students.length === 0) { %>
    <p class="text-muted mb-0">No active students in this batch.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table mb-0 table-stack">
        <thead><tr><th>Student</th><th>Present</th><th>Absent</th><th>Attendance</th><th class="text-end">Details</th></tr></thead>
        <tbody>
          <% students.forEach(s => { %>
            <tr>
              <td><%= s.name %></td>
              <td><%= s.present %></td>
              <td><%= s.absent %></td>
              <td>
                <% if (s.percent === null) { %>-<% } else { %>
                  <span class="badge text-bg-<%= s.percent >= 75 ? 'success' : (s.percent >= 50 ? 'warning' : 'danger') %>"><%= s.percent %>%</span>
                <% } %>
              </td>
              <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/admin/attendance/student/<%= s.id %>?month=<%= month %>">Calendar</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
