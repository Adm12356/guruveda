<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0">Events</h1>
  <a class="btn btn-primary" href="/admin/events/new">Add event</a>
</div>
<div class="admin-card">
  <% if (events.length === 0) { %>
    <p class="text-muted mb-0">No events yet. Add your first one.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table mb-0 table-stack">
        <thead><tr><th>Photo</th><th>Title</th><th>Date</th><th>Location</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
          <% events.forEach(e => { %>
            <tr>
              <td><% if (e.image) { %><img class="thumb" src="/images/events/<%= e.image %>" alt=""><% } else { %><div class="thumb"></div><% } %></td>
              <td><%= e.title %></td>
              <td><%= new Date(e.event_date).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                <% if (new Date(e.event_date) < new Date()) { %><span class="badge text-bg-secondary">Past</span><% } %></td>
              <td><%= e.location || '-' %></td>
              <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" href="/admin/events/<%= e.id %>/edit">Edit</a>
                <form method="POST" action="/admin/events/<%= e.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this event?')">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
