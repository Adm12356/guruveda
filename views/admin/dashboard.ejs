<%- include('partials/header') %>
<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
  <div class="col-md-4"><a class="text-decoration-none" href="/admin/events"><div class="admin-card"><div class="stat"><%= counts.events %></div><div class="text-muted">Upcoming events</div></div></a></div>
  <div class="col-md-4"><a class="text-decoration-none" href="/admin/batches"><div class="admin-card"><div class="stat"><%= counts.batches %></div><div class="text-muted">Active batches</div></div></a></div>
  <div class="col-md-4"><a class="text-decoration-none" href="/admin/messages"><div class="admin-card"><div class="stat"><%= counts.messages %></div><div class="text-muted">Messages received</div></div></a></div>
</div>

<div class="admin-card">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="h5 mb-0">Latest messages</h2>
    <a href="/admin/messages">View all</a>
  </div>
  <% if (recent.length === 0) { %>
    <p class="text-muted mb-0">No messages yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table mb-0 table-stack">
        <thead><tr><th>Date</th><th>Name</th><th>Phone</th><th>Batch</th></tr></thead>
        <tbody>
          <% recent.forEach(m => { %>
            <tr>
              <td><%= new Date(m.created_at).toLocaleString('en-IN') %></td>
              <td><%= m.name %></td>
              <td><a href="tel:<%= m.phone %>"><%= m.phone %></a></td>
              <td><%= m.batch_interest || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
