<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 mb-0">Teachers</h1>
  <a class="btn btn-primary" href="/admin/teachers/new">Add teacher</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-4"><div class="admin-card"><div class="stat"><%= totals.batches %></div><div class="text-muted">Batches</div></div></div>
  <div class="col-4"><div class="admin-card"><div class="stat"><%= totals.students %></div><div class="text-muted">Students</div></div></div>
  <div class="col-4"><div class="admin-card"><div class="stat"><%= totals.exams %></div><div class="text-muted">Exams conducted</div></div></div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table mb-0 table-stack">
      <thead><tr><th>Teacher</th><th>Username</th><th>Batches</th><th>Students</th><th>Exams conducted</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% teachers.forEach(t => { %>
          <tr>
            <td><%= t.name || t.username %><% if (t.role === 'owner') { %> <span class="badge text-bg-primary">Owner</span><% } %></td>
            <td><code><%= t.username %></code></td>
            <td><%= t.batches %></td>
            <td><%= t.students %></td>
            <td><%= t.exams_conducted %><% if (t.exams_created > t.exams_conducted) { %> <span class="text-muted small">(<%= t.exams_created %> created)</span><% } %></td>
            <td><span class="badge text-bg-<%= t.is_active ? 'success' : 'secondary' %>"><%= t.is_active ? 'Active' : 'Disabled' %></span></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-primary" href="/admin/teachers/<%= t.id %>">View full</a>
              <a class="btn btn-sm btn-outline-primary" href="/admin/teachers/<%= t.id %>/edit">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="text-muted small mt-3 mb-0">"Exams conducted" counts exams that at least one student has taken up to today.</p>
</div>
<%- include('partials/footer') %>
