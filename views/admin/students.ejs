<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1 fw-bold text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Students Directory</h1>
    <p class="text-muted small mb-0">Manage enrolled students, login credentials, and batch assignments.</p>
  </div>
  <a class="btn btn-primary rounded-pill px-4 shadow-sm" href="/admin/students/new">
    <i class="bi bi-person-plus-fill me-1"></i>Add Student
  </a>
</div>

<div class="admin-card shadow-sm">
  <% if (students.length === 0) { %>
    <div class="p-5 text-center">
      <i class="bi bi-people display-4 text-muted mb-3 d-block"></i>
      <h3 class="h5">No students enrolled yet</h3>
      <p class="text-muted mb-3">Add a student to generate their login credentials and assign them to a batch.</p>
      <a class="btn btn-primary rounded-pill px-4" href="/admin/students/new">Add First Student</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle table-hover mb-0 table-stack">
        <thead class="table-light">
          <tr>
            <th>Student Name</th>
            <th>Username</th>
            <th>Batch</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(s => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="student-avatar-circle">
                    <%= s.name.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <strong class="text-dark d-block"><%= s.name %></strong>
                    <small class="text-muted">ID #<%= s.id %></small>
                  </div>
                </div>
              </td>
              <td>
                <code class="bg-light px-2 py-1 rounded border text-primary"><%= s.username %></code>
              </td>
              <td>
                <% if (s.batch_name) { %>
                  <span class="badge text-bg-light border text-dark fw-semibold"><i class="bi bi-collection me-1 text-primary"></i><%= s.batch_name %></span>
                <% } else { %>
                  <span class="badge text-bg-warning bg-opacity-25 text-dark"><i class="bi bi-exclamation-circle me-1"></i>Unassigned</span>
                <% } %>
              </td>
              <td>
                <span class="badge rounded-pill <%= s.is_active ? 'text-bg-success' : 'text-bg-secondary' %> px-3 py-1">
                  <i class="bi <%= s.is_active ? 'bi-check-circle-fill' : 'bi-dash-circle-fill' %> me-1"></i><%= s.is_active ? 'Active' : 'Disabled' %>
                </span>
              </td>
              <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1" href="/admin/students/<%= s.id %>/edit">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <form method="POST" action="/admin/students/<%= s.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this student and all of their exam results?')">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn btn-sm btn-outline-danger rounded-pill px-3" type="submit">
                    <i class="bi bi-trash me-1"></i>Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>