<%- include('partials/header') %>
<%- include('partials/page-header', { heading: 'About us', sub: 'A friendly place where children learn to calculate with their minds.' }) %>

<section class="section">
  <div class="container">
    <div class="row gy-4 align-items-center">
      <div class="col-lg-6">
        <h2 class="section-title">Our story</h2>
        <p>Replace this with a short history of your institute: when you started, why you teach abacus, and what makes your classes different.</p>
        <p>Our trainers are certified, our batches are small, and every child moves up the levels at a pace that suits them.</p>
      </div>
      <div class="col-lg-6">
        <!-- Add public/images/about/class.jpg to replace the placeholder -->
        <div class="photo-slot" style="--img: url('/images/about/story.jpeg');" role="img" aria-label="Students in an abacus class"></div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="section-title">How learning works</h2>
    <ol class="steps">
      <li><strong>Demo class.</strong> Your child tries the abacus for free.</li>
      <li><strong>Placement.</strong> We suggest the right level and batch.</li>
      <li><strong>Weekly classes.</strong> Bead work first, then mental visualisation.</li>
      <li><strong>Level exams.</strong> Certificates after every level.</li>
    </ol>
  </div>
</section>

<!-- Our trainers -->
<section class="section">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">Founded and Managed By</h2>

    <% const trainers = [
      {
        name: 'Sandhya Shinde Patil',
        initials: 'SP',
        photo: 'sandhya.jpeg',
        role: 'Abacus Trainer',
        qualification: 'M.A. ,B.Ed, DSM , Certified Abacus, phonics, Vedic teacher ',
        experience: '6 Years',
        tone: 'yellow'
      },
      {
        name: 'Rupali Kale',
        initials: 'RK',
        photo: 'rupali.jpeg',
        role: 'Abacus Trainer',
        qualification: 'MSc (maths)',
        experience: '5 Years',
        tone: 'teal'
      }
    ]; %>

    <div class="row g-4 justify-content-center">
      <% trainers.forEach(function (t) { %>
        <div class="col-md-6 col-lg-5">
          <article class="trainer-card" style="--c: var(--<%= t.tone %>);">
            <div class="trainer-photo">
              <span class="trainer-initials" aria-hidden="true"><%= t.initials %></span>
              <img src="/images/about/<%= t.photo %>" alt="<%= t.name %>" loading="lazy" onerror="this.style.display='none'">
            </div>
            <div class="trainer-info">
              <h3 class="h4"><%= t.name %></h3>
              <p class="trainer-role"><%= t.role %></p>
              <dl class="trainer-facts">
                <dt>Qualification</dt><dd><%= t.qualification %></dd>
                <dt>Experience</dt><dd><%= t.experience %></dd>
              </dl>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>


<!-- Our branches -->



<!-- Our branches (edited by the owner in Admin > Locations) -->
<% if (mainBranches.length || franchises.length) { %>
<section class="section section-tint">
  <div class="container">
    <h2 class="section-title" style="text-align: center;">Our Branches</h2>
    <div class="branches-panel">
      <% if (mainBranches.length) { %>
        <h3 class="branches-heading"><span aria-hidden="true">🏢</span> Main Branches</h3>
        <div class="row g-3 mb-4">
          <% mainBranches.forEach(function (b) { %>
            <div class="col-md-6">
              <div class="branch-main">
                <h4 class="branch-name"><span aria-hidden="true">📍</span> <%= b.name %></h4>
                <% if (b.note) { %><p class="branch-note"><%= b.note %></p><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (franchises.length) { %>
        <h3 class="branches-heading"><span aria-hidden="true">🌍</span> Franchises</h3>
        <div class="row g-3">
          <% franchises.forEach(function (f) { %>
            <div class="col-6 col-lg-4"><div class="branch-franchise"><%= f.name %></div></div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
