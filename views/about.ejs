<%- include('partials/header') %>
<%- include('partials/page-header', { heading: 'About Us', sub: 'A vibrant academy where children discover the joy of fast mental calculation.' }) %>

<!-- Story Section -->
<section class="section">
  <div class="container">
    <div class="row gy-4 align-items-center">
      <div class="col-lg-6">
        <div class="section-badge mb-2"><i class="bi bi-book-half me-1"></i>Our Mission</div>
        <h2 class="section-title">Nurturing Confident, Agile Thinkers</h2>
        <p class="lead text-muted">At <%= site.name %>, we believe that every child is inherently capable of mathematical genius when given the right sensory tools.</p>
        <p>Through structured abacus training, children transition from tactile bead manipulation to pure mental projection. The outcome isn't just fast arithmetic; it develops deep concentration, whole-brain hemispheric activation, photographic memory, and infectious self-confidence in school and beyond.</p>
        <div class="row g-3 pt-2">
          <div class="col-sm-6">
            <div class="feature-bullet">
              <i class="bi bi-patch-check-fill text-warning fs-4"></i>
              <div>
                <strong>ISO Certified Pedagogy</strong>
                <p class="small text-muted mb-0">Systematic levels with progressive skill checks.</p>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="feature-bullet">
              <i class="bi bi-people-fill text-teal fs-4"></i>
              <div>
                <strong>Intimate Batches</strong>
                <p class="small text-muted mb-0">6 to 10 students ensuring personal mentoring.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="about-photo-wrapper">
          <div class="about-photo-card" style="--img: url('/images/about/story.jpeg');">
            <div class="photo-overlay-chip">
              <i class="bi bi-stars text-warning me-1"></i>Learning by Doing
            </div>
          </div>
          <div class="floating-badge-bottom">
            <span class="fs-4">🏆</span>
            <div>
              <strong class="d-block">Championship Ready</strong>
              <small class="text-muted">Regional & State Level Competitions</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Learning Roadmap -->
<section class="section section-tint py-5">
  <div class="container">
    <div class="text-center max-w-600 mx-auto mb-5">
      <div class="section-badge mb-2"><i class="bi bi-signpost-split me-1"></i>Curriculum</div>
      <h2 class="section-title">The Student Journey</h2>
      <p class="text-muted">A clear, supportive path designed to transform hesitation into mastery.</p>
    </div>

    <div class="row g-4 roadmap-row">
      <div class="col-md-6 col-lg-3">
        <div class="roadmap-card step-1">
          <div class="step-num">01</div>
          <div class="step-icon"><i class="bi bi-emoji-smile"></i></div>
          <h3 class="h5 step-title">Free Demo</h3>
          <p class="step-desc">Your child touches the beads for the first time in an engaging, pressure-free session.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="roadmap-card step-2">
          <div class="step-num">02</div>
          <div class="step-icon"><i class="bi bi-compass"></i></div>
          <h3 class="h5 step-title">Personal Placement</h3>
          <p class="step-desc">We match your child into the right age and difficulty batch for optimal pace.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="roadmap-card step-3">
          <div class="step-num">03</div>
          <div class="step-icon"><i class="bi bi-lightning-charge"></i></div>
          <h3 class="h5 step-title">Weekly Drills</h3>
          <p class="step-desc">Finger-dexterity exercises, flash-cards, speed audio tests, and mental abacus visualisation.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="roadmap-card step-4">
          <div class="step-num">04</div>
          <div class="step-icon"><i class="bi bi-award"></i></div>
          <h3 class="h5 step-title">Certified Mastery</h3>
          <p class="step-desc">Earn official level completion certificates and compete in inter-school tournaments.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Our Trainers -->
<section class="section">
  <div class="container">
    <div class="text-center max-w-600 mx-auto mb-5">
      <div class="section-badge mb-2"><i class="bi bi-heart-fill text-danger me-1"></i>Leadership</div>
      <h2 class="section-title">Founded & Managed By</h2>
      <p class="text-muted">Passionate educators with years of certified experience in Abacus, Vedic Maths, and Child Pedagogy.</p>
    </div>

    <% const trainers = [
      {
        name: 'Sandhya Shinde Patil',
        initials: 'SP',
        photo: 'sandhya.jpeg',
        role: 'Founder & Master Trainer',
        qualification: 'M.A., B.Ed, DSM, Certified Abacus, Phonics & Vedic Teacher',
        experience: '6+ Years',
        tone: 'yellow'
      },
      {
        name: 'Rupali Kale',
        initials: 'RK',
        photo: 'rupali.jpeg',
        role: 'Co-Founder & Senior Trainer',
        qualification: 'M.Sc (Mathematics), Certified Abacus Educator',
        experience: '5+ Years',
        tone: 'teal'
      }
    ]; %>

    <div class="row g-4 justify-content-center">
      <% trainers.forEach(function (t) { %>
        <div class="col-md-6 col-lg-5">
          <article class="trainer-card" style="--c: var(--<%= t.tone %>);">
            <div class="trainer-photo-wrap">
              <span class="trainer-initials" aria-hidden="true"><%= t.initials %></span>
              <img src="/images/about/<%= t.photo %>" alt="<%= t.name %>" loading="lazy" class="trainer-img" onerror="this.style.display='none'">
              <span class="trainer-verified-pill"><i class="bi bi-check-circle-fill me-1"></i>Certified</span>
            </div>
            <div class="trainer-info">
              <h3 class="h4 trainer-name"><%= t.name %></h3>
              <p class="trainer-role-badge"><%= t.role %></p>
              <div class="trainer-meta-box">
                <div class="meta-row">
                  <span class="meta-lbl"><i class="bi bi-mortarboard me-1"></i>Qualification</span>
                  <span class="meta-val"><%= t.qualification %></span>
                </div>
                <div class="meta-row">
                  <span class="meta-lbl"><i class="bi bi-clock-history me-1"></i>Experience</span>
                  <span class="meta-val"><%= t.experience %></span>
                </div>
              </div>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Our Branches -->
<% if (mainBranches.length || franchises.length) { %>
<section class="section section-tint py-5">
  <div class="container">
    <div class="text-center max-w-600 mx-auto mb-5">
      <div class="section-badge mb-2"><i class="bi bi-buildings me-1"></i>Our Footprint</div>
      <h2 class="section-title">Our Centres & Locations</h2>
      <p class="text-muted">Find a convenient <%= site.name %> centre near your neighborhood.</p>
    </div>

    <div class="branches-container">
      <% if (mainBranches.length) { %>
        <div class="branch-category-block mb-5">
          <div class="d-flex align-items-center gap-2 mb-3">
            <span class="branch-cat-pill bg-primary text-white"><i class="bi bi-star-fill me-1 text-warning"></i>Head Office & Main Centres</span>
          </div>
          <div class="row g-3">
            <% mainBranches.forEach(function (b) { %>
              <div class="col-md-6">
                <div class="branch-card main-branch-card">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                      <h4 class="branch-title"><i class="bi bi-geo-alt-fill text-danger me-1"></i><%= b.name %></h4>
                      <% if (b.note) { %><p class="branch-note text-muted mb-0"><%= b.note %></p><% } %>
                    </div>
                    <span class="badge text-bg-primary rounded-pill">Main</span>
                  </div>
                  <div class="mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between align-items-center">
                    <span class="small text-muted"><i class="bi bi-check2 text-success me-1"></i>Air-conditioned & Equipped</span>
                    <a href="/contact" class="btn btn-sm btn-outline-primary">Visit Centre</a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (franchises.length) { %>
        <div class="branch-category-block">
          <div class="d-flex align-items-center gap-2 mb-3">
            <span class="branch-cat-pill bg-teal text-white"><i class="bi bi-diagram-3-fill me-1"></i>Partner & Franchise Locations</span>
          </div>
          <div class="row g-3">
            <% franchises.forEach(function (b) { %>
              <div class="col-sm-6 col-lg-3">
                <div class="branch-card franchise-card h-100">
                  <div class="branch-title-wrap">
                    <i class="bi bi-pin-map-fill text-teal me-1"></i>
                    <h4 class="branch-title h6 mb-0 d-inline"><%= b.name %></h4>
                  </div>
                  <span class="badge text-bg-light border text-muted mt-2">Franchise</span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>